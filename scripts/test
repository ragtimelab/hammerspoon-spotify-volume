#!/bin/zsh
set -euo pipefail

repository_root=${0:A:h:h}
cd "$repository_root"

/bin/zsh Tests/Shell/source_checks_test.zsh
/bin/zsh scripts/check-source

lua_binary=${LUA_BIN:-}
if [[ -z "$lua_binary" ]]; then
    for candidate in "$(command -v luajit 2>/dev/null || true)" /opt/local/bin/luajit "$(command -v lua 2>/dev/null || true)"; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            lua_binary=$candidate
            break
        fi
    done
fi
if [[ -z "$lua_binary" ]]; then
    print -u2 "Lua or LuaJIT is required to run the test suite"
    exit 1
fi

"$lua_binary" Tests/Lua/run.lua
swift run -Xswiftc -warnings-as-errors spotify-osd-protocol-tests
swift run -Xswiftc -warnings-as-errors spotify-control-tests
swift build -Xswiftc -warnings-as-errors --product spotify-control

for script in scripts/*; do
    [[ -f "$script" ]] || continue
    case "$(head -n 1 "$script")" in
        *zsh) /bin/zsh -n "$script" ;;
        *ruby) /usr/bin/ruby -c "$script" ;;
    esac
done

print "All source tests passed"
